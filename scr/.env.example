# Copie para scr/.env.local (que não vai para o Git) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# --- Navegador (prefixo VITE_: vão para o JavaScript público) ---
# Supabase: use o projeto de TESTES no desenvolvimento. A chave anon/publishable
# é pública por natureza; a proteção fica nas regras RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# --- Servidor (sem VITE_: só as funções de scr/api enxergam) ---
# Gemini (leitura da fatura) — usado por /api/analisar-fatura
GEMINI_API_KEY=
# Gravação das medições do ESP32 — usado por /api/sensor
SUPABASE_URL=
SUPABASE_KEY=
# Opcional: token que o ESP32 envia no cabeçalho x-device-token
DEVICE_TOKEN=
